# Database Credentials (Supabase)
SUPABASE_DB_URL=jdbc:postgresql://db.dhfstnonquoyfgnpswsw.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_actual_db_password_here

# Active Spring Profile (dev / prod)
SPRING_PROFILES_ACTIVE=dev

# Host URL for generating proxy click links
BACKEND_BASE_URL=http://localhost:8080
PORT=8080

# Account-service integration: issuer must exactly equal JWT_ISSUER on the security service.
ADROVIS_AUTH_ISSUER=https://adrovis-influencer-security.onrender.com
ADROVIS_AUTH_AUDIENCE=adrovis-platform
ADROVIS_AUTH_PUBLIC_KEY_LOCATION=file:/etc/secrets/adrovis-public.pem
ADROVIS_AUTH_STATUS_URL=https://adrovis-influencer-security.onrender.com/api/v1/auth/me
ADROVIS_AUTH_STATUS_TIMEOUT=10s
ADROVIS_FRONTEND_ORIGIN=https://YOUR_ACTUAL_FRONTEND_DOMAIN
# Local public-key location: file:.secrets/adrovis-public.pem
# Local frontend origin: http://localhost:3000

GUEST_APPLY_LIMIT=3
GUEST_APPLY_COOKIE_SECURE=true
GUEST_APPLY_COOKIE_SAME_SITE=Lax
